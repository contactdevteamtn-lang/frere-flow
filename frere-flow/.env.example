# Adresse de l'API (frere-flow-backend). Par défaut : port 4000 de la même machine.
# Exemple si le serveur est sur un autre PC du réseau : VITE_API_URL=http://192.168.1.20:4000/api
VITE_API_URL=

# ───────── Hébergement à deux adresses (ex. Render) ─────────
# Au build : VITE_API_URL=/api  (le navigateur appelle l'API à l'adresse du site)
# Au démarrage du serveur du site : relais /api vers l'API (inutile avec Caddy)
# API_PROXY_TARGET=https://frere-flow-api.onrender.com
# Même valeur que PROXY_SECRET du backend (32 caractères minimum) : transmet l'IP réelle des visiteurs
# PROXY_SECRET=
